<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%request.setAttribute("pageTitle","Work Proof Verification");%><%@ include file="WEB-INF/header.jsp" %>
<div class="cardx pad"><div class="toolbar"><div><b>Work proof</b><div class="mini"><%= "STAFF".equals(current.role()) ? "Upload evidence after completing an assigned duty. Administrators and supervisors cannot upload here." : "Check files submitted by staff. Verify a valid proof to mark the related duty completed." %></div></div><%if("STAFF".equals(current.role())){%><span class="badge-soft b-blue">STAFF UPLOAD ONLY</span><%}else{%><span class="badge-soft b-green">REVIEW ONLY</span><%}%></div>
<%if("STAFF".equals(current.role())){%><div class="card-lite mb-4"><b>Submit completed-work proof</b><p class="mini">Select an assigned duty and upload JPG, JPEG, PNG or PDF up to 5 MB.</p><form method="post" action="documents" enctype="multipart/form-data" class="row g-3 mt-1"><input type="hidden" name="action" value="upload"><div class="col-md-6"><label class="form-label">Assigned duty</label><select class="form-select" name="duty_id" required><option value="">Select duty</option><%for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("assignments")){%><option value="<%=x.get("dutyId")%>"><%=x.get("name")%> · <%=x.get("date")%> · <%=x.get("status")%></option><%}%></select></div><div class="col-md-6"><label class="form-label">Proof file</label><input class="form-control" type="file" name="file" accept=".jpg,.jpeg,.png,.pdf" required></div><div class="col-12"><button class="btn-main"><i class="fa-solid fa-upload"></i> Upload proof</button></div></form></div><%}%>
<div class="table-responsive"><table class="table"><thead><tr><th>Staff</th><th>Duty</th><th>File</th><th>Submitted</th><th>Verification</th><th>Review note</th><th></th></tr></thead><tbody><%List<Map<String,Object>>docs=(List<Map<String,Object>>)request.getAttribute("docs");if(docs==null||docs.isEmpty()){%><tr><td colspan="7" class="mini">No work-proof records found.</td></tr><%}else for(Map<String,Object>x:docs){%><tr><td><b><%=x.get("c3")%></b><div class="mini"><%=x.get("c2")%></div></td><td><%=x.get("c4")%></td><td><a href="document-download?id=<%=x.get("c1")%>"><%=x.get("c5")%></a><div class="mini"><%=x.get("c6")%></div></td><td><%=x.get("c9")%></td><td><span class="badge-soft <%=x.get("c7").equals("VERIFIED")?"b-green":x.get("c7").equals("REJECTED")?"b-red":"b-amber"%>"><%=x.get("c7")%></span></td><td class="mini"><%=x.get("c8")==null?"":x.get("c8")%></td><td><%if(!"STAFF".equals(current.role())&&"PENDING".equals(x.get("c7"))){%><div class="d-flex gap-2"><form method="post" action="documents"><input type="hidden" name="action" value="review"><input type="hidden" name="document_id" value="<%=x.get("c1")%>"><input type="hidden" name="status" value="VERIFIED"><button class="btn-soft" onclick="return confirmAction('Verify this proof and mark the duty completed?')"><i class="fa-solid fa-check"></i> Work done</button></form><form method="post" action="documents"><input type="hidden" name="action" value="review"><input type="hidden" name="document_id" value="<%=x.get("c1")%>"><input type="hidden" name="status" value="REJECTED"><button class="btn-soft" onclick="return confirmAction('Reject this proof?')">Reject</button></form></div><%}%></td></tr><%}%></tbody></table></div></div>
<%@ include file="WEB-INF/footer.jsp" %>
