<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%request.setAttribute("pageTitle","Supervisor Management");%><%@ include file="WEB-INF/header.jsp" %>
<div class="cardx pad"><div class="toolbar"><div><b>Department supervisors</b><div class="mini">Only administrators can create supervisor accounts and assign their work areas.</div></div><button class="btn-main" data-bs-toggle="modal" data-bs-target="#supervisorModal" onclick="newSupervisor()">+ Add supervisor</button></div><div class="info-strip"><i class="fa-solid fa-shield-halved"></i><span>Supervisors can manage duties, leave approvals, attendance and work-proof verification only inside their assigned department(s). Staff creation remains administrator-only.</span></div><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Supervisor</th><th>Username</th><th>Assigned department(s)</th><th>Email</th><th>Status</th><th>Actions</th></tr></thead><tbody><%List<Map<String,Object>>rows=(List<Map<String,Object>>)request.getAttribute("rows");for(Map<String,Object>x:rows){%><tr><td><b><%=x.get("c3")%></b></td><td><%=x.get("c2")%></td><td><%=x.get("c6")%></td><td><%=x.get("c4")%></td><td><span class="badge-soft <%=x.get("c5").equals("ACTIVE")?"b-green":"b-gray"%>"><%=x.get("c5")%></span></td><td><div class="d-flex gap-2"><button class="btn-soft" onclick="editSupervisor('<%=x.get("c1")%>','<%=String.valueOf(x.get("c2")).replace("'","&#39;")%>','<%=String.valueOf(x.get("c3")).replace("'","&#39;")%>','<%=String.valueOf(x.get("c4")).replace("'","&#39;")%>','<%=x.get("c7")%>')">Edit</button><form method="post" action="supervisors"><input type="hidden" name="action" value="status"><input type="hidden" name="user_id" value="<%=x.get("c1")%>"><input type="hidden" name="status" value="<%=x.get("c5")%>"><button class="btn-soft" onclick="return confirmAction('<%=x.get("c5").equals("ACTIVE")?"Deactivate":"Activate"%> this supervisor?')"><%=x.get("c5").equals("ACTIVE")?"Deactivate":"Activate"%></button></form><button type="button" class="btn-soft" onclick="resetSupervisor('<%=x.get("c1")%>')">Reset password</button></div></td></tr><%}%></tbody></table></div></div>
<div class="modal fade" id="supervisorModal"><div class="modal-dialog modal-lg"><div class="modal-content"><form method="post" action="supervisors"><div class="modal-header"><div><b id="supervisorFormTitle">Add supervisor</b><div class="mini">A supervisor must have at least one assigned department.</div></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="action" value="save"><input type="hidden" id="supId" name="user_id"><div class="row g-3"><div class="col-md-6"><label class="form-label">Full name</label><input id="supName" class="form-control" name="full_name" required></div><div class="col-md-6"><label class="form-label">Email</label><input id="supEmail" class="form-control" type="email" name="email" required></div><div class="col-md-6"><label class="form-label">Username</label><input id="supUsername" class="form-control" name="username" required></div><div class="col-md-6"><label class="form-label">Password</label><input id="supPassword" class="form-control" type="password" name="password" minlength="8"><div class="mini">Required for a new account; optional when editing.</div></div><div class="col-12"><label class="form-label">Assigned department(s)</label><div class="row"><%for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("departments")){%><div class="col-md-4 mb-2"><label class="mini"><input class="supDept" type="checkbox" name="department_id" value="<%=x.get("id")%>"> <%=x.get("name")%></label></div><%}%></div></div></div></div><div class="modal-footer"><button type="button" class="btn-soft" data-bs-dismiss="modal">Cancel</button><button class="btn-main">Save supervisor</button></div></form></div></div></div>
<script>function newSupervisor(){document.getElementById('supervisorFormTitle').innerText='Add supervisor';document.getElementById('supId').value='';document.getElementById('supUsername').value='';document.getElementById('supName').value='';document.getElementById('supEmail').value='';document.getElementById('supPassword').value='';document.querySelectorAll('.supDept').forEach(x=>x.checked=false);}
function editSupervisor(id,u,n,e,depts){document.getElementById('supervisorFormTitle').innerText='Edit supervisor';document.getElementById('supId').value=id;document.getElementById('supUsername').value=u;document.getElementById('supName').value=n;document.getElementById('supEmail').value=e;document.getElementById('supPassword').value='';document.querySelectorAll('.supDept').forEach(x=>x.checked=depts.split(',').includes(x.value));new bootstrap.Modal(document.getElementById('supervisorModal')).show();}function resetSupervisor(id){const pw=window.prompt('Enter a new password (minimum 8 characters):');if(!pw)return;if(pw.length<8){alert('Password must be at least 8 characters.');return;}const f=document.createElement('form');f.method='post';f.action='supervisors';[['action','reset'],['user_id',id],['password',pw]].forEach(([n,v])=>{const i=document.createElement('input');i.type='hidden';i.name=n;i.value=v;f.appendChild(i);});document.body.appendChild(f);f.submit();}</script>
<%@ include file="WEB-INF/footer.jsp" %>
