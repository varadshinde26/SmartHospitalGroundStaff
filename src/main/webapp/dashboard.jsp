<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%request.setAttribute("pageTitle","Dashboard");String role=(String)request.getAttribute("dashboardRole");%><%@ include file="WEB-INF/header.jsp" %>
<% Map<String,Integer> stats=(Map<String,Integer>)request.getAttribute("stats"); List<Map<String,Object>> recent=(List<Map<String,Object>>)request.getAttribute("recent"); List<Map<String,Object>> proofs=(List<Map<String,Object>>)request.getAttribute("pendingProofs"); Map<String,Object> nextDuty=(Map<String,Object>)request.getAttribute("nextDuty"); %>
<div class="dashboard-head cardx pad mb-3"><div><span class="role-chip"><%=role%></span><h3 class="mb-1 mt-2"><%="ADMIN".equals(role)?"Hospital-wide operations":"SUPERVISOR".equals(role)?"Department operations":"My workday"%></h3><p class="mini mb-0"><%= "ADMIN".equals(role)?"Manage supervisors, workforce, duties, approvals and verification across the hospital.":"SUPERVISOR".equals(role)?"Manage only your assigned department(s), allocate duties and verify submitted work proof.":"Your assigned duties, work status, attendance, notifications and work-proof submissions in one place." %></p></div><div class="dashboard-actions"><%if("STAFF".equals(role)){%><a class="btn-main" href="my-duties">View my duties</a><a class="btn-soft" href="documents">Work proof</a><%}else{%><a class="btn-main" href="duties">Open duty control</a><a class="btn-soft" href="documents">Review work proof</a><%}%></div></div>
<%if("STAFF".equals(role)){%>
<div class="cardx pad mb-3"><div class="toolbar"><div><b>Next assigned duty</b><div class="mini">This card is updated directly from Smart Allocation assignments.</div></div><span class="badge-soft b-blue">LIVE ASSIGNMENT</span></div><%if(nextDuty==null){%><div class="empty"><i class="fa-solid fa-calendar-xmark fa-2x mb-3"></i><div><b>No upcoming duty is assigned yet.</b></div><div class="mini mt-1">When a supervisor uses Smart Allocation to assign you a duty, it will appear here automatically.</div><a class="btn-soft mt-3" href="my-duties">Open My Duties</a></div><%}else{%><div class="next-duty-card"><div><div class="mini"><%=nextDuty.get("dept")%> · #<%=nextDuty.get("id")%></div><h4 class="mb-1"><%=nextDuty.get("name")%></h4><div class="mini"><%=nextDuty.get("date")%> · <%=nextDuty.get("start")%> – <%=nextDuty.get("end")%></div></div><div class="text-end"><span class="badge-soft <%=String.valueOf(nextDuty.get("priority")).equals("EMERGENCY")?"b-red":String.valueOf(nextDuty.get("priority")).equals("HIGH")?"b-amber":"b-blue"%>"><%=nextDuty.get("priority")%></span><div class="mt-2"><span class="badge-soft b-blue"><%=nextDuty.get("status")%></span></div></div></div><div class="mt-3"><a class="btn-main" href="my-duties">Open assignment</a></div><%}%></div>
<%}%>
<div class="grid4 stat-grid mb-4"><%for(Map.Entry<String,Integer>e:stats.entrySet()){%><div class="cardx stat"><div class="label"><%=e.getKey()%></div><div class="value"><%=e.getValue()%></div><div class="hint"><%if("STAFF".equals(role)){%>Based on your assignments and activity<%}else{%>Role-appropriate live count<%}%></div></div><%}%></div>
<div class="grid2"><div class="cardx pad"><div class="toolbar"><div><b><%="STAFF".equals(role)?"My assigned duties":"Recent operational duties"%></b><div class="mini"><%="STAFF".equals(role)?"Assignments received through Smart Allocation and duty control.":"Current assignment state and work area"%></div></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Duty</th><th>Window</th><%if(!"STAFF".equals(role)){%><th>Work area</th><%}%><th>Status</th></tr></thead><tbody><%if(recent==null||recent.isEmpty()){%><tr><td colspan="4" class="mini">No duty records yet.</td></tr><%}else for(Map<String,Object>x:recent){%><tr><td><b><%=x.get("name")%></b><div class="mini"><%=x.get("date")%></div></td><td><%=x.get("start")%> – <%=x.get("end")%></td><%if(!"STAFF".equals(role)){%><td><%=x.get("dept")%><div class="mini"><%=x.get("staff")%></div></td><%}%><td><span class="badge-soft b-blue"><%=x.get("status")%></span></td></tr><%}%></tbody></table></div><%if("STAFF".equals(role)){%><a class="btn-soft mt-3" href="my-duties">View all my duties</a><%}%></div>
<div class="cardx pad"><div class="toolbar"><div><b><%= "STAFF".equals(role)?"Work-proof status":"Work proof requiring review"%></b><div class="mini"><%= "STAFF".equals(role)?"Submit proof only after starting an assigned duty.":"Review the file submitted by staff before closing the duty."%></div></div></div><%if("STAFF".equals(role)){%><div class="empty"><i class="fa-solid fa-file-circle-check fa-2x mb-3"></i><div>Proof submission is available from <b>Work Proof</b>.</div><div class="mini mt-1">A verified proof completes the assigned duty.</div><a class="btn-main mt-3" href="documents">Open Work Proof</a></div><%}else if(proofs==null||proofs.isEmpty()){%><div class="empty"><i class="fa-solid fa-circle-check fa-2x mb-3"></i><div>No pending work proofs.</div><div class="mini">When staff submit evidence, it will appear here and under Work Proof.</div></div><%}else{%><div class="proof-list"><%for(Map<String,Object>x:proofs){%><div class="proof-row"><div><b><%=x.get("staff")%></b><div class="mini"><%=x.get("duty")%> · <%=x.get("file")%></div></div><a class="btn-soft" href="document-download?id=<%=x.get("id")%>">Check proof</a></div><%}%></div><a class="btn-soft mt-3" href="documents">Open all proofs</a><%}%></div></div>
<%@ include file="WEB-INF/footer.jsp" %>
