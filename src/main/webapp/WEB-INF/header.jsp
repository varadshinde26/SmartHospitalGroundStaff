<%@ page import="com.smarthospital.model.User" %>
<% User current=(User)session.getAttribute("user"); String uri=request.getRequestURI(); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Smart Hospital Ground Staff</title><link rel="preconnect" href="https://cdn.jsdelivr.net"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/app.css"></head><body><div class="shell"><aside class="side"><div class="brand"><span class="mark">SH</span><div class="brand-copy"><strong>Smart Hospital</strong><small>Ground Staff Operations</small></div></div><div class="side-divider"></div><nav class="nav" aria-label="Main navigation">
<div class="section">WORKSPACE</div>
<a class="<%=uri.endsWith("dashboard")?"active":""%>" href="<%=request.getContextPath()%>/dashboard"><i class="fa-solid fa-table-cells-large"></i><span>Dashboard</span></a>
<% if(current!=null && !"STAFF".equals(current.role())) { %><a class="<%=uri.endsWith("staff")?"active":""%>" href="<%=request.getContextPath()%>/staff"><i class="fa-solid fa-users"></i><span>Staff Directory</span></a><% } %>
<% if(current!=null && "ADMIN".equals(current.role())) { %><a class="<%=uri.endsWith("supervisors")?"active":""%>" href="<%=request.getContextPath()%>/supervisors"><i class="fa-solid fa-user-shield"></i><span>Supervisors</span></a><% } %>
<% if(current!=null && !"STAFF".equals(current.role())) { %><a class="<%=uri.endsWith("duties")?"active":""%>" href="<%=request.getContextPath()%>/duties"><i class="fa-solid fa-clipboard-list"></i><span>Duty Control</span></a><% } %>
<% if(current!=null && "STAFF".equals(current.role())) { %><a class="<%=uri.endsWith("my-duties")?"active":""%>" href="<%=request.getContextPath()%>/my-duties"><i class="fa-solid fa-list-check"></i><span>My Duties</span></a><% } %>
<div class="section operations-section">OPERATIONS</div>
<% if(current!=null && !"STAFF".equals(current.role())) { %><a class="<%=uri.endsWith("allocation")?"active":""%>" href="<%=request.getContextPath()%>/duties"><i class="fa-solid fa-bullseye"></i><span>Smart Allocation</span></a><% } %>
<a class="<%=uri.endsWith("leave")?"active":""%>" href="<%=request.getContextPath()%>/leave"><i class="fa-solid fa-calendar-days"></i><span>Leave</span></a>
<a class="<%=uri.endsWith("attendance")?"active":""%>" href="<%=request.getContextPath()%>/attendance"><i class="fa-solid fa-user-check"></i><span>Attendance</span></a>
<a class="<%=uri.endsWith("documents")?"active":""%>" href="<%=request.getContextPath()%>/documents"><i class="fa-solid fa-file-circle-check"></i><span>Work Proof</span></a>
<a class="<%=uri.endsWith("notifications")?"active":""%>" href="<%=request.getContextPath()%>/notifications"><i class="fa-solid fa-bell"></i><span>Notifications</span></a>
<% if(current!=null && !"STAFF".equals(current.role())) { %><div class="section account-section">ANALYTICS</div><a class="<%=uri.endsWith("reports")?"active":""%>" href="<%=request.getContextPath()%>/reports"><i class="fa-solid fa-chart-column"></i><span>Reports</span></a><% } %>
<% if(current!=null){ %><a class="logout-link" href="<%=request.getContextPath()%>/logout"><i class="fa-solid fa-right-from-bracket"></i><span>Sign out</span></a><% } %>
</nav></aside><main class="main"><div class="top"><div><div class="eyebrow">Hospital operations</div><div class="title"><%=request.getAttribute("pageTitle")!=null?request.getAttribute("pageTitle"):"Workspace"%></div><div class="sub">Role-based ground-staff scheduling, workload and work verification</div></div><div class="user-pill"><b><%=current!=null?current.username():""%></b> · <%=current!=null?current.role():""%></div></div>
