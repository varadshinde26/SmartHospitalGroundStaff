<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%request.setAttribute("pageTitle","Duty Control");%><%@ include file="WEB-INF/header.jsp" %>
<div class="cardx pad"><div class="toolbar"><div><b>Duty schedule</b><div class="mini">Create duties, inspect assignment state and open smart allocation</div></div><button class="btn-main" data-bs-toggle="modal" data-bs-target="#dutyModal">+ Create duty</button></div><div class="table-responsive"><table class="table"><thead><tr><th>Duty</th><th>Date & window</th><th>Work area</th><th>Role</th><th>Priority</th><th>Assignment</th><th></th></tr></thead><tbody><%List<Map<String,Object>>rows=(List<Map<String,Object>>)request.getAttribute("rows");for(Map<String,Object>x:rows){%><tr><td><b><%=x.get("c2")%></b><div class="mini">#<%=x.get("c1")%></div></td><td><%=x.get("c3")%><br><span class="mini"><%=x.get("c4")%> – <%=x.get("c5")%></span></td><td><%=x.get("c8")%></td><td><%=x.get("c9")%></td><td><span class="badge-soft <%=x.get("c6").equals("EMERGENCY")?"b-red":x.get("c6").equals("HIGH")?"b-amber":"b-gray"%>"><%=x.get("c6")%></span></td><td><%=x.get("c10")%><div class="mini"><%=x.get("c7")%></div></td><td><button class="btn-soft" onclick="openAllocation(<%=x.get("c1")%>, '<%=String.valueOf(x.get("c2")).replace("'","\\'")%>')">Recommend</button></td></tr><%}%></tbody></table></div></div>
<div class="modal fade" id="dutyModal"><div class="modal-dialog modal-lg"><div class="modal-content"><form method="post" action="duties"><div class="modal-header"><b>Create duty</b><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-8"><label class="form-label">Duty name</label><input class="form-control" name="duty_name" required placeholder="ICU Patient Assistance"></div><div class="col-md-4"><label class="form-label">Priority</label><select class="form-select" name="priority"><option>NORMAL</option><option>LOW</option><option>HIGH</option><option>EMERGENCY</option></select></div><div class="col-md-6"><label class="form-label">Work area</label><select class="form-select" name="department_id"><%for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("departments")){%><option value="<%=x.get("id")%>"><%=x.get("name")%></option><%}%></select></div><div class="col-md-6"><label class="form-label">Required role</label><select class="form-select" name="role_id"><%for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("roles")){%><option value="<%=x.get("id")%>"><%=x.get("name")%></option><%}%></select></div><div class="col-md-4"><label class="form-label">Date</label><input class="form-control" type="date" name="duty_date" required></div><div class="col-md-4"><label class="form-label">Start</label><input class="form-control" type="time" name="start_time" required></div><div class="col-md-4"><label class="form-label">End</label><input class="form-control" type="time" name="end_time" required></div><div class="col-12"><label class="form-label">Required skills</label><div class="row"> <%for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("skills")){%><div class="col-md-4"><label class="mini"><input type="checkbox" name="skill_id" value="<%=x.get("id")%>"> <%=x.get("name")%></label></div><%}%></div></div><div class="col-12"><label class="form-label">Duty description</label><textarea class="form-control" name="description" rows="3"></textarea></div></div></div><div class="modal-footer"><button class="btn-soft" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn-main">Create duty</button></div></form></div></div></div>
<div class="modal fade" id="allocationModal"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><div><b>Explainable allocation</b><div class="mini" id="allocationDuty"></div></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="recommendations"></div></div></div></div>
<script>function openAllocation(id,name){document.getElementById('allocationDuty').innerText='Duty #'+id+' · '+name;new bootstrap.Modal(document.getElementById('allocationModal')).show();loadRecommendations('<%=request.getContextPath()%>',id)}</script><%@ include file="WEB-INF/footer.jsp" %>
