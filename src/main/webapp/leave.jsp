<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%request.setAttribute("pageTitle","Leave Management");%><%@ include file="WEB-INF/header.jsp" %>
<div class="cardx pad"><div class="toolbar"><div><b>Leave requests</b><div class="mini"><%= "STAFF".equals(current.role()) ? "Submit and track your own leave requests." : "Review leave requests only for the staff you are authorized to manage." %></div></div><%if("STAFF".equals(current.role())){%><button class="btn-main" data-bs-toggle="modal" data-bs-target="#leaveModal">+ Request leave</button><%}%></div><div class="table-responsive"><table class="table"><thead><tr><th>Staff</th><th>Period</th><th>Reason</th><th>Status</th><th></th></tr></thead><tbody><%List<Map<String,Object>>rows=(List<Map<String,Object>>)request.getAttribute("rows");if(rows.isEmpty()){%><tr><td colspan="5" class="mini">No leave requests found.</td></tr><%}else for(Map<String,Object>x:rows){%><tr><td><b><%=x.get("c2")%></b><div class="mini"><%=x.get("c3")%></div></td><td><%=x.get("c4")%> → <%=x.get("c5")%></td><td><%=x.get("c6")%></td><td><span class="badge-soft <%=x.get("c7").equals("APPROVED")?"b-green":x.get("c7").equals("REJECTED")?"b-red":"b-amber"%>"><%=x.get("c7")%></span></td><td><%if(!"STAFF".equals(current.role())&&x.get("c7").equals("PENDING")){%><form method="post" action="leave" class="d-flex gap-2"><input type="hidden" name="leave_id" value="<%=x.get("c1")%>"><button name="action" value="approve" class="btn-soft">Approve</button><button name="action" value="reject" class="btn-soft">Reject</button></form><%}%></td></tr><%}%></tbody></table></div></div>
<%if("STAFF".equals(current.role())){%><div class="modal fade" id="leaveModal"><div class="modal-dialog"><div class="modal-content"><form method="post" action="leave"><div class="modal-header"><b>Request leave</b><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="action" value="request"><label class="form-label">Start date</label><input class="form-control mb-3" type="date" name="start_date" required><label class="form-label">End date</label><input class="form-control mb-3" type="date" name="end_date" required><label class="form-label">Reason</label><textarea class="form-control" name="reason" required></textarea></div><div class="modal-footer"><button class="btn-main">Submit request</button></div></form></div></div></div><%}%><%@ include file="WEB-INF/footer.jsp" %>
