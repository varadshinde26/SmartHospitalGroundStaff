<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%request.setAttribute("pageTitle","Attendance");%><%@ include file="WEB-INF/header.jsp" %><div class="grid2"><div class="cardx pad"><b>Record attendance</b><p class="mini">Check-in and check-out records are tied to the staff member and date.</p><% if (!"STAFF".equals(current.role())) { %><form method="post" action="attendance" class="mt-3"><input type="hidden" name="action" value="checkin"><label class="form-label">Staff</label><select class="form-select mb-3" name="staff_id"><%for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("staff")){%><option value="<%=x.get("id")%>"><%=x.get("code")%> · <%=x.get("name")%></option><%}%></select><button class="btn-main">Record check-in</button></form><% } else { %><form method="post" action="attendance" class="mt-3"><input type="hidden" name="action" value="checkin"><input type="hidden" name="staff_id" value="0"><button class="btn-main">Record my check-in</button></form><% } %></div><div class="cardx pad"><b>Attendance ledger</b><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Staff</th><th>Date</th><th>In</th><th>Out</th><th>Status</th><th></th></tr></thead><tbody><%for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("rows")){%><tr><td><b><%=x.get("c4")%></b><div class="mini"><%=x.get("c3")%></div></td><td><%=x.get("c5")%></td><td><%=x.get("c6")%></td><td><%=x.get("c7")%></td><td><span class="badge-soft b-green"><%=x.get("c8")%></span></td><td><%if(x.get("c7")==null){%><form method="post" action="attendance"><input type="hidden" name="action" value="checkout"><input type="hidden" name="attendance_id" value="<%=x.get("c1")%>"><input type="hidden" name="staff_id" value="<%=x.get("c2")%>"><button class="btn-soft">Check-out</button></form><%}%></td></tr><%}%></tbody></table></div></div></div><%@ include file="WEB-INF/footer.jsp" %>
