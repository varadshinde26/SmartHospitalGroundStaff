<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%request.setAttribute("pageTitle","My Duties");%><%@ include file="WEB-INF/header.jsp" %>
<div class="cardx pad"><div class="toolbar"><div><b>Assigned duties</b><div class="mini">Acknowledge the duty, start it when work begins, then submit proof after completion.</div></div><a class="btn-soft" href="documents">Work proof</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Duty</th><th>Date</th><th>Window</th><th>Priority</th><th>Duty status</th><th>Proof</th><th>Action</th></tr></thead><tbody><%List<Map<String,Object>>rows=(List<Map<String,Object>>)request.getAttribute("rows");if(rows==null||rows.isEmpty()){%><tr><td colspan="7" class="mini">No duties assigned to you.</td></tr><%}else for(Map<String,Object>x:rows){String st=String.valueOf(x.get("c8"));String proof=String.valueOf(x.get("c9"));%><tr><td><b><%=x.get("c3")%></b><div class="mini">#<%=x.get("c2")%></div></td><td><%=x.get("c4")%></td><td><%=x.get("c5")%> – <%=x.get("c6")%></td><td><span class="badge-soft <%=x.get("c7").equals("EMERGENCY")?"b-red":"b-gray"%>"><%=x.get("c7")%></span></td><td><span class="badge-soft b-blue"><%=st%></span></td><td><span class="badge-soft <%=proof.equals("VERIFIED")?"b-green":proof.equals("REJECTED")?"b-red":proof.equals("PENDING")?"b-amber":"b-gray"%>"><%=proof%></span></td><td><div class="d-flex gap-2"><%if(st.equals("ASSIGNED")){%><form method="post" action="my-duties"><input type="hidden" name="assignment_id" value="<%=x.get("c1")%>"><button class="btn-main" name="action" value="acknowledge">Acknowledge</button></form><%}else if(st.equals("ACKNOWLEDGED")){%><form method="post" action="my-duties"><input type="hidden" name="assignment_id" value="<%=x.get("c1")%>"><button class="btn-main" name="action" value="start">Start work</button></form><%}else if(st.equals("IN_PROGRESS")){%><a class="btn-main" href="documents">Submit proof</a><%}else if(st.equals("CHANGE_REQUESTED")){%><span class="mini">Change requested</span><%}else if(st.equals("COMPLETED")){%><span class="mini">Completed</span><%}%><%if(st.equals("ASSIGNED")||st.equals("ACKNOWLEDGED")){%><form method="post" action="my-duties"><input type="hidden" name="assignment_id" value="<%=x.get("c1")%>"><button class="btn-soft" name="action" value="change">Request change</button></form><%}%></div></td></tr><%}%></tbody></table></div></div><%@ include file="WEB-INF/footer.jsp" %>
