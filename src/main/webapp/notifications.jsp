<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%request.setAttribute("pageTitle","Notifications");%><%@ include file="WEB-INF/header.jsp" %><div class="cardx pad"><div class="toolbar"><div><b>Notification centre</b><div class="mini">Assignment, change, reminder and approval messages</div></div></div><%List<Map<String,Object>>rows=(List<Map<String,Object>>)request.getAttribute("rows");if(rows.isEmpty()){%><div class="empty">No notifications yet.</div><%}else for(Map<String,Object>x:rows){%><div class="d-flex justify-content-between align-items-center" style="padding:14px 0;border-bottom:1px solid #eef0f4"><div><span class="badge-soft <%=x.get("c4").equals("UNREAD")?"b-blue":"b-gray"%>"><%=x.get("c3")%></span><div class="mt-1"><%=x.get("c2")%></div><div class="mini"><%=x.get("c5")%></div></div><%if(x.get("c4").equals("UNREAD")){%><form method="post" action="notifications"><input type="hidden" name="notification_id" value="<%=x.get("c1")%>"><button class="btn-soft">Mark read</button></form><%}%></div><%}%></div><%@ include file="WEB-INF/footer.jsp" %>
