<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · Smart Hospital</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="assets/css/app.css"></head><body><div class="login-page"><section class="login-left"><div class="eyebrow" style="color:#8fa3c2">Operational workforce platform</div><h1>Better duty decisions for the people who keep a hospital moving.</h1><p>Manage ground staff, create duties, identify eligible candidates, balance workload and keep every assignment traceable.</p><div class="mini" style="color:#8393ab;margin-top:30px">JSP · Servlets · JDBC · JavaScript/AJAX · PHP · MySQL</div></section><section class="login-right"><form class="login-box" method="post" action="login"><div class="eyebrow">Secure access</div><h2>Sign in</h2><p class="sub mb-4">Use your hospital operations account.</p><% String remembered=""; if(request.getCookies()!=null) for(Cookie c:request.getCookies()) if("remember_username".equals(c.getName())) remembered=c.getValue(); %><% if(request.getAttribute("error")!=null){ %><div class="alert alert-danger"><%=request.getAttribute("error")%></div><% } %><label class="form-label">Username</label><input class="form-control mb-3" name="username" value="<%=remembered%>" required autocomplete="username"><label class="form-label">Password</label><input class="form-control mb-2" type="password" name="password" required autocomplete="current-password"><div class="form-check mb-4"><input class="form-check-input" type="checkbox" name="remember" id="remember"><label class="form-check-label mini" for="remember">Remember username on this device</label></div><button class="btn-main w-100" type="submit">Sign in</button><div class="mt-4 p-3" style="background:#f6f8fb;border:1px solid #e8ebf0;border-radius:8px"><div class="mini"><b>Demo accounts</b></div><div class="mini">admin / admin@123</div><div class="mini">supervisor / supervisor@123</div><div class="mini">staff101 / staff@123</div></div></form></section></div></body></html>
