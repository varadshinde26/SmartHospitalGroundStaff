<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%request.setAttribute("pageTitle","Reports & Analytics");%><%@ include file="WEB-INF/header.jsp" %><div class="grid4 mb-4"><%Map<String,Integer>d=(Map<String,Integer>)request.getAttribute("dutyStats");for(Map.Entry<String,Integer>x:d.entrySet()){%><div class="cardx stat"><div class="label"><%=x.getKey()%></div><div class="value"><%=x.getValue()%></div></div><%}%></div><div class="grid2"><div class="cardx pad"><b>Staff by work area</b><div class="chartbar mt-4"><%List<Map<String,Object>>a=(List<Map<String,Object>>)request.getAttribute("department");int max=1;for(Map<String,Object>x:a)max=Math.max(max,(Integer)x.get("value"));for(Map<String,Object>x:a){int v=(Integer)x.get("value");%><div class="bar" style="height:<%=Math.max(12,v*150/max)%>px"><i><%=v%></i><label><%=x.get("name").toString().replace("/","/")%></label></div><%}%></div></div><div class="cardx pad"><b>Duty distribution</b><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Staff</th><th>Duties</th></tr></thead><tbody><%for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("workload")){%><tr><td><%=x.get("name")%></td><td><b><%=x.get("value")%></b></td></tr><%}%></tbody></table></div></div></div><%@ include file="WEB-INF/footer.jsp" %>
